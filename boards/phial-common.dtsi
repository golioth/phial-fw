/*
 * Phial board hardware description — shared across every app in this repo.
 * Pulled in by each app's `boards/<board_target>.overlay` via #include.
 *
 * Source of truth for pin assignments: docs/superpowers/specs/2026-05-14-phial-bringup-design.md
 *
 * NOTE: LEDs 13–16 are on the TRACEDATA / SWO pins (P2.07–P2.10). They work
 * fine as plain GPIOs, but enabling SWO-based debug output will collide with
 * LED16 (P2.07). Standard SWD debug on the dedicated SWDIO/SWCLK pins is
 * unaffected.
 *
 * We build against the `nrf54l15dk/nrf54l15/cpuapp` target, which enables a
 * bunch of DK-specific peripherals that claim GPIO pins overlapping with the
 * Phial LEDs. The block below disables them and deletes the DK's onboard
 * LED / button nodes. Without this, ~10 of the 16 LEDs are silently grabbed
 * by spi00 / pwm20 / uart30 / DK gpio-leds / DK gpio-keys and won't toggle.
 */

/* ---------------------------------------------------------------------------
 * Disable DK peripherals whose default pinctrl claims Phial LED pins
 * ------------------------------------------------------------------------- */

&spi00 {
    /* DK QSPI flash on P2.01 (SCK) / P2.02 (MOSI) / P2.04 (MISO) / P2.05 (CS)
     * — those are our LED10 / LED09 / LED07 / LED06. Phial has no QSPI flash. */
    status = "disabled";
};

&mx25r64 {
    /* Flash chip child of the now-disabled spi00 — disable for clarity. */
    status = "disabled";
};

&pwm20 {
    /* DK's pwm20 default routes PWM_OUT0 to P1.10 = our LED01. We will
     * re-enable pwm20 in Phase 2 with our own pinctrl group for pwm-leds. */
    status = "disabled";
};

/* The DK common dtsi defines a `pwm-leds` node (`/pwmleds`) whose sole child
 * references &pwm20. As of NCS 3.2.3 the led_pwm driver resolves that phandle
 * for EVERY child (DT_INST_FOREACH_CHILD_SEP is not status-filtered), so a
 * disabled pwm20 makes led_pwm.c fail to build with `__device_dts_ord_NN
 * undeclared`. Disable the whole pwm-leds node (it is unlabeled, hence the
 * path reference) so no led_pwm instance is generated. Phial drives its LEDs
 * via plain GPIO, not PWM. */
&{/pwmleds} {
    status = "disabled";
};

&uart30 {
    /* DK's uart30 default routes RTS to P0.02 = our LED04. uart30 isn't
     * used on Phial. */
    status = "disabled";
};

/* uart20 (the DK's J-Link VCOM UART) is left status="okay" so the
 * shell-serial backend has a binding. Its default pinctrl puts TX/RX/RTS/CTS
 * on P1.04–P1.07, none of which are Phial LED pins, so no conflict — but
 * those are the DK's VCOM pins, not the Phial's actual UART pins.
 *
 * On Phial the UART is routed through the Tag-Connect SWD debug header
 * (J103): TX on pin 7, RX on pin 8.  Those connect to nRF54L15 pins
 * P1.08 (TX) and P1.07 (RX) respectively — see the KiCad netlist nets
 * /nRF52_TX and /nRF52_RX (pads 9 and 8 of the QFAA package).
 *
 * We override uart20's pinctrl below with the Phial-specific group that
 * routes TX→P1.08, RX→P1.07, no flow control. */

&pinctrl {
    /omit-if-no-ref/ uart20_phial_default: uart20_phial_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 7)>;
        };
        group2 {
            psels = <NRF_PSEL(UART_RX, 1, 8)>;
            bias-pull-up;
        };
    };

    /omit-if-no-ref/ uart20_phial_sleep: uart20_phial_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 7)>,
                    <NRF_PSEL(UART_RX, 1, 8)>;
            low-power-enable;
        };
    };
};

&uart20 {
    pinctrl-0 = <&uart20_phial_default>;
    pinctrl-1 = <&uart20_phial_sleep>;
    pinctrl-names = "default", "sleep";
};

/* ---------------------------------------------------------------------------
 * I²C bus — SERIAL30 as TWIM on the Phial's port-0 pins.
 *
 * uart20 owns SERIAL instance 20, so I²C uses instance 30. Instance 30 is the
 * low-power-domain serial peripheral, and it is the one that can reach port-0
 * GPIOs — the high-speed instances (20/21/22) route to P1/P2 only. uart30 is
 * disabled above, which frees SERIAL30 for TWIM use here (same peripheral,
 * different personality — only one may be "okay").
 *
 * Phial schematic: SDA = P0.00, SCL = P0.01. Internal pull-ups are enabled as
 * a bring-up safety net; harmless if the board also fits external pull-ups.
 *
 * Bus hosts BME280, LIS2DH (U10), ATECC608B, nPM2100. We instantiate only the
 * controller for now so `i2c scan i2c30` works; per-sensor child nodes +
 * bindings come in Phase 2 once `i2c scan` confirms the 7-bit addresses.
 * ------------------------------------------------------------------------- */

&pinctrl {
    /omit-if-no-ref/ i2c30_phial_default: i2c30_phial_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 1)>;
            bias-pull-up;
        };
    };

    /omit-if-no-ref/ i2c30_phial_sleep: i2c30_phial_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 0)>,
                    <NRF_PSEL(TWIM_SCL, 0, 1)>;
            low-power-enable;
        };
    };
};

&i2c30 {
    status = "okay";
    clock-frequency = <100000>;   /* I2C_BITRATE_STANDARD; bump to 400000 later */
    pinctrl-0 = <&i2c30_phial_default>;
    pinctrl-1 = <&i2c30_phial_sleep>;
    pinctrl-names = "default", "sleep";
};

/* LIS2DH12 3-axis accelerometer (U10) on the Phial sensor bus.
 * Dual compatible is REQUIRED: the Zephyr driver matches DT_DRV_COMPAT
 * `st_lis2dh` and CONFIG_LIS2DH depends on DT_HAS_ST_LIS2DH_ENABLED; a node
 * with only `st,lis2dh12` binds no driver. Inert for apps without
 * CONFIG_LIS2DH (e.g. led-test), so this stays in the shared overlay. */
&i2c30 {
    accel: lis2dh12@18 {
        compatible = "st,lis2dh12", "st,lis2dh";
        reg = <0x18>;
        status = "okay";
    };
};

/* BME280 temperature / humidity / pressure sensor on the Phial sensor bus.
 * Single compatible (no dual-compatible quirk like the LIS2DH12). NOTE:
 * CONFIG_BME280 is `default y` when this node is present, so the driver builds
 * into every app that includes this dtsi (not just sensor-test). Harmless —
 * a few KB of flash and an unread device. Set CONFIG_BME280=n in an app's
 * prj.conf if footprint matters there. */
&i2c30 {
    bme280: bme280@76 {
        compatible = "bosch,bme280";
        reg = <0x76>;
        status = "okay";
    };
};

/* ---------------------------------------------------------------------------
 * Delete the DK's onboard LED and button nodes
 *
 * The DK's `/leds/led_0..led_3` claim P2.09 / P1.10 / P2.07 / P1.14
 * = our LED14 / LED01 / LED16 / LED12. The DK's `/buttons/button_0..3`
 * claim P1.13 / P1.09 / P1.08 / P0.04 — button1 grabs P1.09 = our LED02
 * as an input with pull-up.
 *
 * We use label-based deletion (the DK labels these nodes).
 * ------------------------------------------------------------------------- */

/delete-node/ &led0;
/delete-node/ &led1;
/delete-node/ &led2;
/delete-node/ &led3;

/ {
    /delete-node/ buttons;

    /* DK aliases pointed at the deleted nodes — drop the dangling references.
     * Our own `led0..led15` aliases get re-added in the LED block below. */
    aliases {
        /delete-property/ led0;
        /delete-property/ led1;
        /delete-property/ led2;
        /delete-property/ led3;
        /delete-property/ sw0;
        /delete-property/ sw1;
        /delete-property/ sw2;
        /delete-property/ sw3;
        /delete-property/ mcuboot-led0;
        /delete-property/ mcuboot-button0;
    };
};

/* ---------------------------------------------------------------------------
 * Phial LEDs — 16 GPIO-driven LEDs (12 ring + 4 center)
 * ------------------------------------------------------------------------- */

/ {
    leds: leds {
        compatible = "gpio-leds";

        /* Ring LEDs 1–12 — clock-face layout */
        led01: led_01 { gpios = <&gpio1 10 GPIO_ACTIVE_HIGH>; label = "LED01 (ring 1)";  };
        led02: led_02 { gpios = <&gpio1  9 GPIO_ACTIVE_HIGH>; label = "LED02 (ring 2)";  };
        led03: led_03 { gpios = <&gpio0  3 GPIO_ACTIVE_HIGH>; label = "LED03 (ring 3)";  };
        led04: led_04 { gpios = <&gpio0  2 GPIO_ACTIVE_HIGH>; label = "LED04 (ring 4)";  };
        led05: led_05 { gpios = <&gpio2  6 GPIO_ACTIVE_HIGH>; label = "LED05 (ring 5)";  };
        led06: led_06 { gpios = <&gpio2  5 GPIO_ACTIVE_HIGH>; label = "LED06 (ring 6)";  };
        led07: led_07 { gpios = <&gpio2  4 GPIO_ACTIVE_HIGH>; label = "LED07 (ring 7)";  };
        led08: led_08 { gpios = <&gpio2  3 GPIO_ACTIVE_HIGH>; label = "LED08 (ring 8)";  };
        led09: led_09 { gpios = <&gpio2  2 GPIO_ACTIVE_HIGH>; label = "LED09 (ring 9)";  };
        led10: led_10 { gpios = <&gpio2  1 GPIO_ACTIVE_HIGH>; label = "LED10 (ring 10)"; };
        led11: led_11 { gpios = <&gpio2  0 GPIO_ACTIVE_HIGH>; label = "LED11 (ring 11)"; };
        led12: led_12 { gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>; label = "LED12 (ring 12)"; };

        /* Center LEDs 13–16 — on TRACEDATA / SWO pins */
        led13: led_13 { gpios = <&gpio2  8 GPIO_ACTIVE_HIGH>; label = "LED13 (center)"; };  /* TRACEDATA1 */
        led14: led_14 { gpios = <&gpio2  9 GPIO_ACTIVE_HIGH>; label = "LED14 (center)"; };  /* TRACEDATA2 */
        led15: led_15 { gpios = <&gpio2 10 GPIO_ACTIVE_HIGH>; label = "LED15 (center)"; };  /* TRACEDATA3 */
        led16: led_16 { gpios = <&gpio2  7 GPIO_ACTIVE_HIGH>; label = "LED16 (center, SWO)"; };  /* SWO */
    };

    aliases {
        led0  = &led01;
        led1  = &led02;
        led2  = &led03;
        led3  = &led04;
        led4  = &led05;
        led5  = &led06;
        led6  = &led07;
        led7  = &led08;
        led8  = &led09;
        led9  = &led10;
        led10 = &led11;
        led11 = &led12;
        led12 = &led13;
        led13 = &led14;
        led14 = &led15;
        led15 = &led16;
    };
};

/ {
    zephyr,user {
        /* LF21115TMR omni-polar TMR magnet switch on P1.13 (former DK button0,
         * deleted above). Push-pull output: low = magnet present, so ACTIVE_LOW
         * makes the logical pin value 1 = present. No pull needed. */
        mag-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
        /* ~4 kHz buzzer (transducer) on P0.04 (former DK button3, deleted above).
         * PWM can't reach P0 on nRF54L (power-domain split), so app/buzzer-test
         * drives it via CPU GPIO toggle. */
        buzzer-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
        /* "boot" button on P1.12 (a Phial button, not one of the deleted DK
         * buttons). Active-low (pressed -> GND); configured with an internal
         * pull-up in firmware. Polarity confirmed on this board. */
        button-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
    };
};

/* ---------------------------------------------------------------------------
 * PDM microphone (MP34DT05TR-A) on pdm20.
 *
 * pdm20 is on the global peripheral bus alongside gpio1, so it can route to
 * P1 pins: MIC_CLK = P1.05, MIC_DATA = P1.04. Inert for apps that do not enable
 * CONFIG_AUDIO_DMIC (led/sensor/buzzer-test); app/mic-test drives it.
 * ------------------------------------------------------------------------- */
&pinctrl {
    /omit-if-no-ref/ pdm20_phial_default: pdm20_phial_default {
        group1 {
            psels = <NRF_PSEL(PDM_CLK, 1, 5)>,    /* MIC_CLK  P1.05 */
                    <NRF_PSEL(PDM_DIN, 1, 4)>;     /* MIC_DATA P1.04 */
        };
    };
};

&pdm20 {
    status = "okay";
    pinctrl-0 = <&pdm20_phial_default>;
    pinctrl-names = "default";
    clock-source = "PCLK32M_HFXO";   /* crystal-backed, low jitter; fall back to
                                       * "PCLK32M" if the HFXO won't start */
};

/* ---------------------------------------------------------------------------
 * mic_clip flash partition — 128 KB of RRAM for app/mic-test's WAV clip.
 *
 * Carved from the tail of the RRAM region MCUboot would use for slot1 (image-1,
 * 0xb6000, 664K). This repo builds secure-only with no MCUboot/no DFU, so slot1
 * is unused and free. 0x13c000 + 128K = 0x15c000 = the `storage` partition base
 * (abuts, no overlap); clear of cpuflpr_rram at 0x165000. Inert for apps that
 * never open it.
 *
 * The nRF54L15 SoC dtsi defines slot1_partition at 0xb6000 with size 0xa6000
 * (ending at 0x15c000). We shrink it to end at 0x13c000 (size 0x86000) to make
 * room, then declare mic_clip in the freed tail. Both changes are checked by
 * validate_rram_partitions.c at compile time.
 * ------------------------------------------------------------------------- */
&cpuapp_rram {
    partitions {
        /* Shrink slot1 so it ends at 0x13c000, freeing the tail for mic_clip. */
        slot1_partition: partition@b6000 {
            reg = <0xb6000 DT_SIZE_K(536)>;   /* 0xb6000..0x13c000 (was 664K, shrunk to free 128K for mic_clip) */
        };
        mic_clip_partition: partition@13c000 {
            label = "mic_clip";
            reg = <0x13c000 DT_SIZE_K(128)>;   /* 0x13c000..0x15c000 */
        };
    };
};
